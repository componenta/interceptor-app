{
    "name": "componenta/interceptor-app",
    "description": "Migration provider for native Interceptor 4 runtime integration",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.5.13",
        "componenta/config": "^4.0",
        "componenta/interceptor": "^4.0"
    },
    "autoload": {
        "psr-4": {
            "Componenta\\Interceptor\\App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Componenta\\Interceptor\\App\\Tests\\": "tests/"
        }
    },
    "require-dev": {
        "pestphp/pest": "^4.0",
        "componenta/app-console": "^6.0",
        "componenta/app": "^6.0",
        "componenta/di": "^6.0"
    },
    "minimum-stability": "stable",
    "extra": {
        "componenta": {
            "config-providers": [
                "Componenta\\Interceptor\\App\\ConfigProvider"
            ]
        },
        "branch-alias": {
            "dev-refactor/unified-application-build-2026-11-27": "4.0.x-dev"
        }
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "scripts": {
        "test": "@php vendor/bin/pest",
        "test:integration": "@composer --working-dir=integration test"
    },
    "prefer-stable": true
}
