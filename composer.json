{
    "name": "componenta/interceptor-app",
    "description": "Componenta application integration for interceptor cache compilation",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "componenta/app": "^1.0.2 || ^2.0 || ^3.0.2",
        "componenta/config": "^2.0.2",
        "componenta/interceptor": "^1.0 || ^2.0.1"
    },
    "autoload": {
        "psr-4": {
            "Componenta\\Interceptor\\App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Componenta\\Interceptor\\App\\Tests\\": "tests/"
        }
    },
    "require-dev": {
        "pestphp/pest": "^4.0"
    },
    "minimum-stability": "stable",
    "extra": {
        "componenta": {
            "config-providers": [
                "Componenta\\Interceptor\\App\\ConfigProvider"
            ]
        }
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "scripts": {
        "test": "@php vendor/bin/pest"
    },
    "prefer-stable": true
}
